rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every student workspace is private to its authenticated owner.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Academic catalog records should be published through a separate
    // admin-controlled collection with explicit read-only rules if/when added.
  }
}