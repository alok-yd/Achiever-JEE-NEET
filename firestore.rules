rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Students can access their own workspace documents only.
    // The collection name is checked here because Firestore ORs overlapping
    // allow rules; a broad recursive owner rule would also expose quota docs.
    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName != "usage";
    }

    // AI quota counters are server-managed by Firebase Admin only.
    // Client SDKs cannot read or modify them, even for their own UID.
    match /users/{userId}/usage/{usageDocument} {
      allow read, write: if false;
    }
  }
}