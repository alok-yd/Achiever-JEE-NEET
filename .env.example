# Firebase configuration for a NEW, dedicated ACHIEVER JEE/NEET Firebase project.
# Enable Email/Password in Firebase Authentication and create Firestore + Storage.
# These VITE_ web-app configuration values are public client identifiers; protect data with Firebase Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Server-side AI Mentor. Never expose this key through a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
FIREBASE_SERVICE_ACCOUNT_JSON=
AI_MENTOR_DAILY_LIMIT=60
AI_MENTOR_PER_MINUTE_LIMIT=5
